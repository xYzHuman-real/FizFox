# FizFox API
PORT=8000
FIZFOX_DB_PATH=./fizfox.db

# AI provider. These values are examples only; never commit a real API key.
FIZFOX_AI_BASE_URL=https://api.openai.com/v1
FIZFOX_AI_API_KEY=replace-with-your-api-key
FIZFOX_AI_MODEL=replace-with-your-model
FIZFOX_AI_TIMEOUT=60

# Browser origins allowed to call the backend.
# Replace with the exact origin of your deployed GitHub Pages site.
FIZFOX_ALLOWED_ORIGINS=https://your-user.github.io

# Trusted worker settings (only on a host with Docker installed).
FIZFOX_WORKER_IMAGE=node:22-alpine
FIZFOX_WORKER_TIMEOUT=10
FIZFOX_WORKER_MEMORY=512m
FIZFOX_WORKER_CPUS=1.0
FIZFOX_WORKER_PIDS=64
